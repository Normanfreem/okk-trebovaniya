[Unit]
Description=OKK requirements (v2)
After=network.target

[Service]
Type=simple
User=okk
Group=okk
WorkingDirectory=/opt/okk/app/server
Environment=OKK_DATA=/opt/okk-data
Environment=OKK_WEB=/opt/okk/app/web
ExecStart=/opt/okk/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8001 --workers 1 --no-server-header
Restart=on-failure
RestartSec=3
# изоляция: служба видит только свои папки
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/okk-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
